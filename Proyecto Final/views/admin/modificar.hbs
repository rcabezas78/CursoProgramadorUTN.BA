<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modificar Contenido</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/stylesheets/styleModificar.css" rel="stylesheet">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
</head>

<body>
    <div id="message-container" class="message-banner"></div>

    <div class="container-fluid">
        <div class="row">
            <div class="col-6 offset-3">
                <div class="card p-4 mx-auto form-red-bg" style="max-width: 600px;">
                    <h2 class="text-center resaltado-amarillo">Modificar Contenido</h2>

                    <form id="modificar-form" method="post" action="/admin/ABMContenido/modificar" enctype="multipart/form-data">
                        <input type="hidden" value="{{contenido.id}}" name="id">
                        <input type="hidden" name="nombreArchivo_existente" value="{{contenido.nombreArchivo}}">

                        <div class="mb-3">
                            <label for="evento" class="form-label resaltado-amarillo">Evento</label>
                            <input type="text" class="form-control" id="evento" name="evento" value="{{contenido.evento}}" required>
                        </div>

                        <div class="mb-3">
                            <label for="categorias" class="form-label resaltado-amarillo">Categorías</label>
                            <input type="text" class="form-control" id="categorias" name="categorias" value="{{contenido.categorias}}" required>
                        </div>

                        <div class="mb-3">
                            <label for="descripcion" class="form-label resaltado-amarillo">Descripcion</label>
                            <input type="text" class="form-control" id="descripcion" name="descripcion" value="{{contenido.descripcion}}" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Subir Archivo (Fotos o Videos)</label>
                            <div class="input-group">
                                <label class="btn btn-rojo-amarillo">Examinar...
                                    <input type="file" class="form-control d-none" id="imagen-upload" name="imagen" accept="image/*,video/*">
                                </label>
                                <span class="form-control" id="file-name" style="background-color: white;">No se seleccionó un archivo.</span>
                            </div>

                            {{#if contenido.nombreArchivo}}
                            <p style="color: yellow;">Archivo actual: <strong>{{contenido.nombreArchivo}}</strong></p>
                            {{/if}}
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-murialdo">Modificar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            $('#modificar-form').on('submit', function(event) {
                event.preventDefault(); 
                var formData = new FormData(this);

                $.ajax({
                    url: $(this).attr('action'),
                    type: 'POST',
                    data: formData,
                    processData: false, 
                    contentType: false, 
                    success: function(response) {
                        $('#message-container').empty(); // Limpia los mensajes anteriores
                        let messageHTML = '';
                        if (response.success) {
                            messageHTML = `<div class="alert alert-success mt-2" role="alert" style="background-color: red; color: white;">${response.message}</div>`;
                        } else {
                            messageHTML = `<div class="alert alert-danger mt-2" role="alert" style="background-color: red; color: white;">${response.message}</div>`;
                        }
                        $('#message-container').html(messageHTML);
                    },
                    error: function() {
                        $('#message-container').empty();
                        let errorHTML = `<div class="alert alert-danger mt-2" role="alert" style="background-color: red; color: white;">Error al intentar modificar el contenido.</div>`;
                        $('#message-container').html(errorHTML);
                    }
                });
            });
        });
    </script>
</body>
</html>