<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Administración</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/stylesheets/styleContenido.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
</head>
<body>
    <div class="container my-5">
        <h2 class="text-center mb-4">Panel de Administración</h2>
        <div class="card p-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">Listado de Contenido</h4>
                <a href="/admin/ABMContenido/agregar" class="btn btn-danger">+ Nuevo</a>
            </div>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Foto</th>
                            <th>Nombre Archivo</th>
                            <th>Evento</th>
                            <th>Categorías</th>
                            <th>Descripción</th>
                            <th>Fecha subida</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each contenido}}
                        <tr>
                            <td>{{this.id}}</td>
                            <td>
                                {{#if this.nombreArchivo}}
                                <img src="/images/uploads/{{this.nombreArchivo}}"
                                    style="width: 50px; height: 50px; object-fit: cover;">
                                {{/if}}
                            </td>
                            <td>{{this.nombreArchivo}}</td>
                            <td>{{this.evento}}</td>
                            <td>{{this.categorias}}</td>
                            <td>{{this.descripcion}}</td>
                            <td>{{formatDate this.fechaSubida}}</td>
                            <td class="acciones">
                                <div class="d-flex gap-2">
                                    <a href="/admin/ABMContenido/modificar/{{this.id}}"
                                        class="btn btn-sm btn-info text-white">
                                        <i class="fas fa-pencil-alt"></i>
                                    </a>
                                    <a href="#" class="btn btn-sm btn-danger btn-eliminar" data-id="{{this.id}}">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        {{else}}
                        <tr>
                            <td colspan="8">No hay contenido para mostrar.</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="confirm-modal" class="modal-custom">
        <div class="modal-content-custom">
            <p>¿Está seguro de que desea eliminar este registro?</p>
            <div class="modal-buttons">
                <button id="confirm-delete-btn" class="btn btn-murialdo">Aceptar</button>
                <button id="cancel-delete-btn" class="btn btn-murialdo">Cancelar</button>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const confirmModal = document.getElementById('confirm-modal');
            const confirmBtn = document.getElementById('confirm-delete-btn');
            const cancelBtn = document.getElementById('cancel-delete-btn');
            let deleteId = null;

            document.querySelectorAll('.btn-eliminar').forEach(button => {
                button.addEventListener('click', (event) => {
                    event.preventDefault(); 
                    deleteId = event.target.closest('a').dataset.id;
                    confirmModal.style.display = 'flex';
                });
            });

            confirmBtn.addEventListener('click', () => {
                if (deleteId) {
                    window.location.href = `/admin/ABMContenido/eliminar/${deleteId}`;
                }
            });

            cancelBtn.addEventListener('click', () => {
                confirmModal.style.display = 'none';
                deleteId = null;
            });
        });
    </script>

    <style>
        .modal-custom {
            display: none;
            position: fixed;
            z-index: 1050;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0, 0, 0, 0.4);
            justify-content: center;
            align-items: center;
            padding-top: 50px;
        }

        .modal-content-custom {
            background-color: red;
            color: yellow;
            padding: 20px;
            border: 2px solid yellow;
            width: 80%;
            max-width: 400px;
            text-align: center;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .modal-buttons {
            margin-top: 20px;
            display: flex;
            justify-content: center;
            gap: 20px;
        }

        .btn-murialdo {
            background-color: yellow;
            color: red;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
        }

        .btn-murialdo:hover {
            background-color: #ffd700;
        }
    </style>
</body>
</html>