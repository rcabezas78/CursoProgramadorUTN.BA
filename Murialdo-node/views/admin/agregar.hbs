<div class="container" style="margin:100px auto">
    <div class="row">
        <div class="col-6 offset-3">
            <h4>Agregar Novedad</h4>
            <form action="/admin/novedades/agregar" method="post" enctype="multipart/form-data">

                <div class="form-group">
                    <input type="text" class="form-control" id="titulo" placeholder="Título" name="titulo">
                </div>
                <div class="form-group">
                    <textarea class="form-control" id="subtitulo" placeholder="SubTitulo" name="subtitulo"></textarea>
                </div>
                <div class="form-group">
                    <textarea class="form-control" placeholder="Cuerpo" name="cuerpo"></textarea>
                </div>

                <div class="form-group">
                    <label for="imagen">Subir Imagen</label>
                    <input type="file" class="form-control" id="imagen" name="imagen">
                </div>
                
                <button type="submit" class="btn btn-primary">Guardar</button>
            </form>
            {{#if error}}
            <p class="text-danger mt-2">{{message}}</p>
            {{/if}}
        </div>
    </div>
</div>